generator client {
  provider     = "prisma-client"
  output       = "../src/__generated__/client"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["dbos", "public"]
}

model Project {
  id           String       @id @default(nanoid())
  name         String
  kind         ProjectKind  @default(USER)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  repositories Repository[]
  branches     Branch[]

  @@map("projects")
  @@schema("public")
}

enum ProjectKind {
  USER
  SYSTEM

  @@schema("public")
}

model Repository {
  id        String  @id @default(nanoid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name      String
  remoteUrl String?
  localPath String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([projectId, name])
  @@index([projectId])
  @@map("repositories")
  @@schema("public")
}

// BEGIN @revisium/engine 0.7.0 Prisma models
model Branch {
  id        String     @id
  createdAt DateTime   @default(now())
  isRoot    Boolean    @default(false)
  name      String
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisions Revision[]

  @@unique([name, projectId])

  @@schema("public")
}

model Revision {
  id         String   @id
  sequence   Int      @unique @default(autoincrement())
  createdAt  DateTime @default(now())
  comment    String   @default("")
  isHead     Boolean  @default(false)
  isDraft    Boolean  @default(false)
  isStart    Boolean  @default(false)
  hasChanges Boolean  @default(false)

  branchId String
  branch   Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  parentId String?
  parent   Revision?  @relation("parentRevision", fields: [parentId], references: [id], onDelete: SetNull)
  children Revision[] @relation("parentRevision")
  tables   Table[]

  @@index([branchId])

  @@schema("public")
}

model Table {
  versionId String @id
  createdId String
  id        String

  readonly Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  system Boolean @default(false)

  revisions Revision[]
  rows      Row[]

  @@index([id])

  @@schema("public")
}

model Row {
  versionId String @id
  createdId String
  id        String

  readonly Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  publishedAt DateTime @default(now())

  data       Json
  meta       Json   @default("{}")
  hash       String
  schemaHash String

  tables    Table[]
  fileBlobs FileBlob[] @relation("FileBlobToRow")

  @@index([data], type: Gin)
  @@index([id])
  @@index([hash])
  @@index([schemaHash])
  @@index([publishedAt])

  @@schema("public")
}

model FileBlob {
  id        String    @id @default(nanoid())
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  projectId String
  hash      String
  size      BigInt

  rows Row[] @relation("FileBlobToRow")

  @@unique([projectId, hash])
  @@index([projectId])
  @@index([hash])
  @@index([deletedAt])

  @@schema("public")
}

model ProjectFileUsage {
  projectId String   @id
  fileBytes BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model TableMigration {
  id                   String    @id @default(cuid())
  revisionId           String
  tableId              String
  sourceTableVersionId String
  shadowTableVersionId String?
  status               String    @default("PENDING")
  phase                String    @default("INIT")
  patches              Json
  previousSchema       Json
  previousSchemaHash   String
  targetSchemaHash     String
  totalRows            Int
  copiedRows           Int       @default(0)
  lastCopiedRowId      String?
  batchSize            Int       @default(1000)
  currentBatch         Int       @default(0)
  totalBatches         Int       @default(0)
  createdAt            DateTime  @default(now())
  startedAt            DateTime?
  completedAt          DateTime?
  lastProgressAt       DateTime?
  lockedBy             String?
  lockedAt             DateTime?
  heartbeatAt          DateTime?
  errorMessage         String?
  retryCount           Int       @default(0)
  maxRetries           Int       @default(3)

  @@unique([revisionId, tableId])
  @@index([status])
  @@index([lockedBy])
  @@index([status, heartbeatAt])

  @@schema("public")
}
// END @revisium/engine 0.7.0 Prisma models

// DBOS owns and migrates these tables. Revo only exposes the fields needed by
// operational queries; Prisma Migrate ignores both models via prisma.config.ts.
model DbosWorkflowStatus {
  workflowUuid String @id @map("workflow_uuid")
  status       String
  name         String?
  createdAt    BigInt @map("created_at")
  updatedAt    BigInt @map("updated_at")

  @@map("workflow_status")
  @@schema("dbos")
}

model DbosOperationOutput {
  workflowUuid String @map("workflow_uuid")
  functionId   Int    @map("function_id")
  functionName String? @map("function_name")

  @@id([workflowUuid, functionId])
  @@map("operation_outputs")
  @@schema("dbos")
}
