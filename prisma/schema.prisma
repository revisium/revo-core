generator client {
  provider     = "prisma-client"
  output       = "../src/__generated__/client"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["dbos", "public"]
}

model Project {
  id           String        @id @default(nanoid())
  name         String
  description  String        @default("")
  status       ProjectStatus @default(CREATING)
  kind         ProjectKind   @default(USER)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  repositories Repository[]
  branches     Branch[]

  @@map("projects")
  @@schema("public")
}

enum ProjectStatus {
  CREATING
  ACTIVE
  ARCHIVED

  @@schema("public")
}

enum ProjectKind {
  USER
  SYSTEM

  @@schema("public")
}

model Repository {
  id        String   @id @default(nanoid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name      String
  remoteUrl String?
  localPath String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([projectId, name])
  @@index([projectId])
  @@map("repositories")
  @@schema("public")
}

model ReviewThread {
  id         String          @id
  scopeKey   String
  subjectKey String
  contextKey String?
  context    Json
  version    Int             @default(1)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  resolvedAt DateTime?       @db.Timestamptz(3)
  resolvedBy String?
  messages   ReviewMessage[]

  @@index([scopeKey, subjectKey, resolvedAt])
  @@index([scopeKey, subjectKey, contextKey, resolvedAt])
  @@map("review_threads")
  @@schema("public")
}

model ReviewMessage {
  id        String       @id
  threadId  String
  thread    ReviewThread @relation(fields: [threadId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  authorId  String
  body      String?
  version   Int          @default(1)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  editedAt  DateTime?    @db.Timestamptz(3)
  deletedAt DateTime?    @db.Timestamptz(3)
  deletedBy String?

  @@index([threadId, createdAt, id])
  @@map("review_messages")
  @@schema("public")
}

// BEGIN @revisium/engine 0.7.0 Prisma models
model Branch {
  id        String     @id
  createdAt DateTime   @default(now())
  isRoot    Boolean    @default(false)
  name      String
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisions Revision[]

  @@unique([name, projectId])
  @@schema("public")
}

model Revision {
  id         String   @id
  sequence   Int      @unique @default(autoincrement())
  createdAt  DateTime @default(now())
  comment    String   @default("")
  isHead     Boolean  @default(false)
  isDraft    Boolean  @default(false)
  isStart    Boolean  @default(false)
  hasChanges Boolean  @default(false)

  branchId String
  branch   Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  parentId String?
  parent   Revision?  @relation("parentRevision", fields: [parentId], references: [id], onDelete: SetNull)
  children Revision[] @relation("parentRevision")
  tables   Table[]

  @@index([branchId])
  @@schema("public")
}

model Table {
  versionId String @id
  createdId String
  id        String

  readonly Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  system Boolean @default(false)

  revisions Revision[]
  rows      Row[]

  @@index([id])
  @@schema("public")
}

model Row {
  versionId String @id
  createdId String
  id        String

  readonly Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  publishedAt DateTime @default(now())

  data       Json
  meta       Json   @default("{}")
  hash       String
  schemaHash String

  tables    Table[]
  fileBlobs FileBlob[] @relation("FileBlobToRow")

  @@index([data], type: Gin)
  @@index([id])
  @@index([hash])
  @@index([schemaHash])
  @@index([publishedAt])
  @@schema("public")
}

model FileBlob {
  id        String    @id @default(nanoid())
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  projectId String
  hash      String
  size      BigInt

  rows Row[] @relation("FileBlobToRow")

  @@unique([projectId, hash])
  @@index([projectId])
  @@index([hash])
  @@index([deletedAt])
  @@schema("public")
}

model ProjectFileUsage {
  projectId String   @id
  fileBytes BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model TableMigration {
  id                   String    @id @default(cuid())
  revisionId           String
  tableId              String
  sourceTableVersionId String
  shadowTableVersionId String?
  status               String    @default("PENDING")
  phase                String    @default("INIT")
  patches              Json
  previousSchema       Json
  previousSchemaHash   String
  targetSchemaHash     String
  totalRows            Int
  copiedRows           Int       @default(0)
  lastCopiedRowId      String?
  batchSize            Int       @default(1000)
  currentBatch         Int       @default(0)
  totalBatches         Int       @default(0)
  createdAt            DateTime  @default(now())
  startedAt            DateTime?
  completedAt          DateTime?
  lastProgressAt       DateTime?
  lockedBy             String?
  lockedAt             DateTime?
  heartbeatAt          DateTime?
  errorMessage         String?
  retryCount           Int       @default(0)
  maxRetries           Int       @default(3)

  @@unique([revisionId, tableId])
  @@index([status])
  @@index([lockedBy])
  @@index([status, heartbeatAt])
  @@schema("public")
}

// END @revisium/engine 0.7.0 Prisma models

// DBOS owns and migrates these tables. Revo only exposes the fields needed by
// operational queries; Prisma Migrate ignores both models via prisma.config.ts.
model DbosWorkflowStatus {
  workflowUuid String  @id @map("workflow_uuid")
  status       String
  name         String?
  createdAt    BigInt  @map("created_at")
  updatedAt    BigInt  @map("updated_at")

  @@map("workflow_status")
  @@schema("dbos")
}

model DbosOperationOutput {
  workflowUuid String  @map("workflow_uuid")
  functionId   Int     @map("function_id")
  functionName String? @map("function_name")

  @@id([workflowUuid, functionId])
  @@map("operation_outputs")
  @@schema("dbos")
}

model Dialogue {
  id                      String                    @id
  ordinal                 BigInt                    @unique @default(autoincrement())
  title                   String
  agentId                 String
  agentVersion            String
  agentInstallationId     String
  agentConfiguration      Json                      @default("{\"selections\":{}}")
  metadata                Json                      @default("{}")
  systemContext           String                    @default("")
  status                  DialogueStatus            @default(READY)
  progress                String                    @default("")
  pendingCount            Int                       @default(0)
  lastOutcome             DialogueOutcome?
  activeTurnId            String?
  runtimeSessionId        String?                   @unique
  contextMode             DialogueContextMode       @default(NEW)
  originDialogueId        String?
  originTurnId            String?
  originItemSequence      BigInt?
  itemSequence            BigInt                    @default(0)
  significantSequence     BigInt                    @default(0)
  readSignificantSequence BigInt                    @default(0)
  version                 BigInt                    @default(0)
  createdAt               DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                  @updatedAt @db.Timestamptz(3)
  turns                   DialogueTurn[]
  items                   DialogueHistoryItem[]
  interactions            DialogueInteraction[]
  changes                 DialogueChange[]
  eventStreams            AgentSessionEventStream[]

  @@map("dialogues")
  @@schema("public")
}

enum DialogueStatus {
  READY
  QUEUED
  RUNNING
  WAITING
  UNCERTAIN
  CLOSED

  @@schema("public")
}

enum DialogueOutcome {
  COMPLETED
  CANCELLED
  INTERRUPTED
  FAILED
  UNCERTAIN

  @@schema("public")
}

enum DialogueContextMode {
  NEW
  CONTINUED
  FORK

  @@schema("public")
}

model DialogueTurn {
  id               String                @id
  dialogueId       String
  dialogue         Dialogue              @relation(fields: [dialogueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  commandId        String
  userItemId       String                @unique
  inputSha256      String
  status           DialogueTurnStatus    @default(QUEUED)
  dispatchState    DialogueDispatchState @default(SAVED)
  cancelRequested  Boolean               @default(false)
  runtimeSessionId String?
  outcome          Json                  @default("{}")
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  completedAt      DateTime?             @db.Timestamptz(3)
  endItemSequence  BigInt?

  @@unique([dialogueId, commandId])
  @@index([dialogueId, createdAt, id])
  @@map("dialogue_turns")
  @@schema("public")
}

enum DialogueTurnStatus {
  QUEUED
  RUNNING
  WAITING
  COMPLETED
  CANCELLED
  INTERRUPTED
  FAILED
  UNCERTAIN

  @@schema("public")
}

enum DialogueDispatchState {
  SAVED
  DISPATCHING
  ADMITTED
  FINISHED
  UNCERTAIN

  @@schema("public")
}

model DialogueHistoryItem {
  id         String                    @id
  dialogueId String
  dialogue   Dialogue                  @relation(fields: [dialogueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sequence   BigInt
  turnId     String?
  sourceKey  String?
  kind       DialogueHistoryItemKind
  source     DialogueHistoryItemSource
  text       String                    @default("")
  payload    Json                      @default("{}")
  status     DialogueHistoryItemStatus @default(COMPLETED)
  version    BigInt                    @default(0)
  createdAt  DateTime                  @default(now()) @db.Timestamptz(3)
  historical Boolean                   @default(false)

  @@unique([dialogueId, sequence])
  @@unique([dialogueId, sourceKey])
  @@index([dialogueId, turnId, kind])
  @@map("dialogue_history_items")
  @@schema("public")
}

enum DialogueHistoryItemKind {
  MESSAGE
  OPERATION
  INTERACTION
  RESULT
  PLAN
  USAGE
  CHECKPOINT

  @@schema("public")
}

enum DialogueHistoryItemSource {
  USER
  AGENT
  SYSTEM

  @@schema("public")
}

enum DialogueHistoryItemStatus {
  STREAMING
  COMPLETED
  PARTIAL
  STARTED
  IN_PROGRESS
  FAILED
  INTERRUPTED
  PENDING
  RESPONDING
  RESOLVED
  ABANDONED
  CANCELLED

  @@schema("public")
}

model DialogueInteraction {
  id                String                    @id
  dialogueId        String
  dialogue          Dialogue                  @relation(fields: [dialogueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  turnId            String?
  runtimeSessionId  String
  runtimeRequestId  String
  status            DialogueInteractionStatus @default(PENDING)
  request           Json
  response          Json?
  responseCommandId String?

  @@unique([runtimeSessionId, runtimeRequestId])
  @@index([dialogueId, status])
  @@map("dialogue_interactions")
  @@schema("public")
}

enum DialogueInteractionStatus {
  PENDING
  RESPONDING
  RESOLVED
  ABANDONED

  @@schema("public")
}

model AgentSessionEventStream {
  sessionId  String              @id
  dialogueId String?
  dialogue   Dialogue?           @relation(fields: [dialogueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  streamId   String?
  sequence   Int                 @default(0)
  eventId    String?
  events     AgentSessionEvent[]

  @@map("agent_session_event_streams")
  @@schema("public")
}

model AgentSessionEvent {
  eventId              String                  @id
  sessionId            String
  session              AgentSessionEventStream @relation(fields: [sessionId], references: [sessionId], onDelete: Restrict, onUpdate: Restrict)
  streamId             String
  sequence             Int
  type                 String
  payload              Json
  observedAt           DateTime                @db.Timestamptz(3)
  claimedResumeTokenId String?                 @unique
  createdAt            DateTime                @default(now()) @db.Timestamptz(3)

  @@unique([sessionId, streamId, sequence])
  @@map("agent_session_events")
  @@schema("public")
}

model DialogueChange {
  sequence        BigInt                     @id
  dialogueId      String
  dialogue        Dialogue                   @relation(fields: [dialogueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  kind            DialogueChangeKind
  itemId          String?
  itemVersion     BigInt?
  baseItemVersion BigInt?
  itemSequence    BigInt?
  turnId          String?
  itemKind        DialogueHistoryItemKind?
  itemSource      DialogueHistoryItemSource?
  textDelta       String?
  createdAt       DateTime                   @default(now()) @db.Timestamptz(3)

  @@index([dialogueId, sequence])
  @@map("dialogue_changes")
  @@schema("public")
}

enum DialogueChangeKind {
  SUMMARY_UPDATED
  HISTORY_ITEM_UPSERTED
  HISTORY_TEXT_APPENDED

  @@schema("public")
}

model DialogueFeedPosition {
  id       Int    @id
  sequence BigInt @default(0)

  @@map("dialogue_feed_positions")
  @@schema("public")
}
