{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    ".codegraph/**",
    ".idea/**",
    ".sonar/**",
    "coverage/**",
    "dist/**",
    "node_modules/**",
    "src/__generated__/**"
  ],
  "printWidth": 100,
  "singleQuote": true,
  "sortImports": true,
  "sortPackageJson": true
}
